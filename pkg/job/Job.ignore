package job

import (
	"fmt"
	"strings"

	"github.com/cfjello/go-store/pkg/store"
	"github.com/cfjello/go-store/pkg/types"
	"github.com/cfjello/go-store/pkg/util"
	"github.com/cfjello/hierarkey-go/pkg/hierarkey"
	"github.com/dominikbraun/graph"
	_ "github.com/dominikbraun/graph"
)

type JobService struct {
	JobGraph graph.Graph[string, types.JobVertex]
	Store    *store.Store
}

var js *JobService

func NewJobService(store *store.Store) *JobService {
	g := graph.New(func(jv types.JobVertex) string { return jv.Key + "_" + jv.JobId }, graph.Directed(), graph.Acyclic())
	if js != nil {
		return js
	} else {
		js = &JobService{
			JobGraph: g,
			Store:    store,
		}
	}
	return js
}

func (js *JobService) addJob(rootStoreId string, forceNew bool) (string, error) {
	hk := hierarkey.NewHierarKey(1, 5)
	jobId, err := js.BuildJobGraph(rootStoreId, 0, 4, hk)
	if err != nil {
		return "", fmt.Errorf("failed to build job graph: %v", err)
	}
	return jobId, nil
}

func (js *JobService) SetDependsOn(storeName string, deps []string, replace bool) error {
	if storeName == "" || !js.Store.IsRegistered(storeName) {
		return fmt.Errorf("key %s is not registered", storeName)
	}

	var meta types.MetaData
	var err error
	for _, dep := range deps {
		if !js.Store.IsRegistered(dep) {
			return fmt.Errorf("dependency %s is not registered", dep)
		} else if dep == storeName {
			return fmt.Errorf("object %s cannot depend on itself", dep)
		}

		meta, err = js.Store.GetMetaData(storeName, storeName)
		if err != nil {
			return fmt.Errorf("failed to get metadata for key %s: %v", storeName, err)
		}
	}
	if !replace {
		dependsOn := util.UniqueStrings(append(meta.DependsOn, deps...))
		meta.DependsOn = dependsOn
	} else {
		meta.DependsOn = deps
	}
	if !js.Store.DB.UpsertMeta(storeName, meta) {
		return fmt.Errorf("failed to update metadata for key %s with dependencies %v", storeName, deps)
	}
	return nil
}

func (js *JobService) GetDependsOn(storeName string) ([]string, error) {
	// if storeName == "" || !js.Store.IsRegistered(storeName) {
	// 	return nil, fmt.Errorf("key %s is not registered", storeName)
	// }
	meta, err := js.Store.GetMetaData(storeName, storeName)
	if err != nil {
		return nil, fmt.Errorf("failed to get metadata for key %s: %v", storeName, err)
	}
	return meta.DependsOn, nil
}

func (js *JobService) GetJobEntry(jobId string, currKey string) (JobVertex, error) {
	return js.JobGraph.Vertex(jobId + "_" + currKey)
}

