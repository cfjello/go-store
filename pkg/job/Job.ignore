func (js *JobService) GetCurrJobDef(metaName string) (types.JobDbEntry, error) {

	meta, err := js.Store.GetMetaData(metaName)
	if err != nil {
		return types.JobDbEntry{}, fmt.Errorf("failed to get metadata for metaName %s: %v", metaName, err)
	}
	job, err := js.Store.DB.GetCurrJobDef(metaName, meta.Schema)
	if err != nil {
		return types.JobDbEntry{}, fmt.Errorf("failed to get current job definition for metaName %s: %v", metaName, err)
	}
	return job, nil

}

// Recursive function to build the job graph
// It starts from the top node and traverses through all dependencies
func (js *JobService) BuildJobGraph(currNodeName string, level int, keySize int, hk *hierarkey.HierarKey) (types.JobDbEntry, error) {
	jobId := ""
	// var currNode string = topNode
	var currHKey string

	// First check if the job already exists - select the newest one for the current currJob unless a specific jobId is provided
	currJob, err := js.Store.DB.GetCurrJobEntry(currNodeName, "")

	if err == nil {
		return currJob, nil
	}

	// if not exists, create the job
	if level == 0 {
		jobId = util.Ulid()
		keySize = 4
		hk := hierarkey.NewHierarKey(1, keySize)
		currHKey = hk.NextLeaf()
	} else {
		jobId = strings.SplitAfter(currNodeName, "_")[1]
	}

	vertex := types.JobVertex{
		JobId:    jobId,
		Key:      currHKey,
		NodeName: currNodeName,
		Level:    level,
	}

	vertexHash := vertex.Key + "_" + vertex.JobId
	// Add the very first vertex
	if level == 0 {
		err := js.JobGraph.AddVertex(vertex)
		if err != nil {
			return "", err
		}
	}

	nodes, err := js.GetDependsOn(currNodeName)
	if err != nil {
		return "", err
	}
	for _, node := range nodes {
		currChildKey := hk.NextLeaf()
		childVertex := types.JobVertex{
			JobId:    jobId,
			Key:      currChildKey,
			NodeName: node,
			Level:    level + 1,
		}
		childHash := childVertex.Key + "_" + childVertex.JobId
		if _, err := js.JobGraph.Vertex(childHash); err != nil {
			err := js.JobGraph.AddVertex(childVertex)
			if err != nil {
				return "", err
			}
		}
		if _, err := js.JobGraph.Edge(vertexHash, childHash); err != nil {
			if err = js.JobGraph.AddEdge(vertexHash, childHash); err != nil {
				return "", err
			}
		}
		// Recursively add the job graph for the dependent node
		if _, err = js.BuildJobGraph(childHash, level+1, keySize, hk); err != nil {
			return "", err
		}
	}
	return jobId, nil
}

